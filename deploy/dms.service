[Unit]
Description=DMS Equipment Management System (Flask)
After=network.target mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/EquipmentManagement

# === 数据库：MySQL / MariaDB ===
Environment=DB_TYPE=mysql
Environment=MYSQL_HOST=127.0.0.1
Environment=MYSQL_PORT=3306
Environment=MYSQL_USER=appuser_rw
Environment=MYSQL_PASSWORD=wtf197907!!
# 数据库名未显式设置，沿用 database.py 里 os.environ.get('MYSQL_DATABASE', 'dms_db') 的默认值 dms_db

# 回滚到 SQLite 时改成下面两行并注释掉上面的 mysql 配置：
# Environment=DB_TYPE=sqlite
# Environment=DB_PATH=/data/EquipmentManagement/equipment.db

Environment=SECRET_KEY=3ed60d290350cf2f11a232d9119efe3337fcc63ae51268db78ebf3715bd4406c
Environment=PORT=5000
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1

# 注意：app.py 在被 import 时 app 为 None，必须用工厂函数 create_app()
ExecStart=/usr/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --timeout 120 --access-logfile /data/EquipmentManagement/logs/gunicorn-access.log --error-logfile /data/EquipmentManagement/logs/gunicorn-error.log "app:create_app()"

Restart=always
RestartSec=5
StandardOutput=append:/data/EquipmentManagement/logs/gunicorn.out
StandardError=append:/data/EquipmentManagement/logs/gunicorn.err

[Install]
WantedBy=multi-user.target
