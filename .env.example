# 复制成 .env 后填真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库。

# ---- 数据库 ----
# 生产：宿主机 MariaDB（容器走 host 网络，127.0.0.1 就是宿主机）
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=appuser_rw
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=dms_db

# 本地开发想用 SQLite 时改成：
# DB_TYPE=sqlite
# DB_PATH=/app/data/dms.db

# ---- Flask ----
# 换掉：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# ---- gunicorn ----
# 绑 127.0.0.1 只让 nginx 进来；要直接对外调试再临时改 0.0.0.0
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=2
